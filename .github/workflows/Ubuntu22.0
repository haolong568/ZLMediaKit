name: Ubuntu

on:
  push:
  pull_request:
  workflow_dispatch:

# 发布 Release 需要写权限
permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4
        with:
          ref: 79d795a767da85bbba821b871265fd87d853d808
          submodules: recursive

      - name: 记录实际编译的 commit
        run: echo "BUILT_SHA=$(git rev-parse HEAD)" >> "$GITHUB_ENV"

      - name: 安装编译依赖
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            build-essential cmake pkg-config git \
            libssl-dev libsctp-dev libsrtp2-dev

      - name: CMake 配置
        run: cmake -B build -S . -DCMAKE_BUILD_TYPE=Release

      - name: 编译 MediaServer
        run: |
          if [ ! -f build/Makefile ] && [ ! -f build/build.ninja ]; then
            echo "::error::CMake 配置未生成构建系统"
            exit 1
          fi
          cmake --build build --target MediaServer --parallel "$(nproc)"

      - name: 全工作区收集产物（二进制 + config + pem + www）
        run: |
          mkdir -p dist upload

          # 1) 主程序
          exe=$(find "$GITHUB_WORKSPACE/build" -type f -name MediaServer | head -n 1)
          if [ -z "$exe" ]; then
            exe=$(find "$GITHUB_WORKSPACE" -type f -name MediaServer -not -path "*/.git/*" | head -n 1)
          fi
          if [ -z "$exe" ]; then
            echo "::error::整个工作区未找到 MediaServer 二进制"
            exit 1
          fi
          cp "$exe" dist/MediaServer
          chmod +x dist/MediaServer
          echo "收集: $exe"

          # 2) 配置文件
          for c in server/config.ini conf/config.ini config.ini; do
            if [ -f "$c" ]; then
              cp "$c" dist/config.ini
              echo "收集配置: $c"
            fi
          done

          # 3) default.pem：优先仓库自带，否则生成自签名证书
          pem=$(find "$GITHUB_WORKSPACE" -type f -name default.pem -not -path "*/.git/*" | head -n 1)
          if [ -n "$pem" ]; then
            cp "$pem" dist/default.pem
            echo "收集证书: $pem"
          else
            openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem -days 3650 -nodes -subj "/CN=localhost"
            cat cert.pem key.pem > dist/default.pem
            echo "已生成自签名 default.pem"
          fi

          # 4) www 目录（旧版可能叫 web）
          www=$(find "$GITHUB_WORKSPACE" -maxdepth 3 -type d \( -name www -o -name web \) \
                -not -path "*/.git/*" -not -path "*/build/*" | head -n 1)
          if [ -n "$www" ]; then
            cp -r "$www" dist/www
            echo "收集网页目录: $www"
          else
            echo "⚠ 仓库中未发现 www/web 目录（不影响核心功能）"
          fi

          echo "=== dist 最终内容 ==="
          ls -l dist

      - name: 打包 tar.gz（保留可执行权限）
        run: |
          tar -czf upload/ZLMediaKit-Ubuntu2204-x64.tar.gz -C dist .
          ls -l upload

      - name: 发布到 Releases（独立 Release，保留历史）
        if: github.event_name != 'pull_request'
        uses: softprops/action-gh-release@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        with:
          tag_name: ubuntu-${{ github.run_number }}
          name: "ZLMediaKit Ubuntu22.04 x64 #${{ github.run_number }}"
          target_commitish: ${{ env.BUILT_SHA }}
          body: |
            Ubuntu 22.04 x64 构建（历史版本全部保留，可回滚）。
            实际编译 commit: ${{ env.BUILT_SHA }}
            包内含: MediaServer / config.ini / default.pem / www(如有)
            使用: 解压后 ./MediaServer 运行（1024 以下端口需 root 或 setcap）
          files: upload/ZLMediaKit-Ubuntu2204-x64.tar.gz
          make_latest: true

      - name: 打包二进制（Actions 产物备份）
        uses: actions/upload-artifact@v4
        with:
          name: Ubuntu_${{ github.ref_name }}_${{ github.sha }}
          path: dist/*
          if-no-files-found: error
          retention-days: 90
